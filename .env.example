# Copy this file to .env (gitignored) and fill in real values.
# NEVER commit real values, echo them into output, or write them to a log.
# Every name here maps to a field on `Secrets` in src/srip_filter/config.py.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- Neon Postgres (the ATS's OWN database — never the website's) ---
# DATABASE_URL is the runtime DSN.
#   postgresql://user:pass@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
# Use the POOLED host — the one with "-pooler" in it (P11.4 shipped
# statement_cache_size=0 on the pool, which is what makes asyncpg safe against Neon's
# PgBouncer transaction mode; without it prepared statements fail intermittently).
# Serverless opens many short-lived connections, which is exactly what the pooler is for.
DATABASE_URL=

# DATABASE_URL_TEST points at a separate Neon BRANCH (e.g. "dev") and is used only by
# tests/test_db.py, which creates and drops throwaway schemas — never point it at the
# same branch as DATABASE_URL. Use the DIRECT host (no "-pooler"): the suite does DDL.
# Unset ⇒ the DB tests skip cleanly.
DATABASE_URL_TEST=

# --- Webhook auth (P10) ---
# The static shared secret the website sends as the X-ATS-Secret header. Any random
# string works (a UUID is fine); the same value must be set in the website's Vercel env,
# or its dispatcher sends no header at all and every delivery is rejected 401.
ATS_WEBHOOK_SECRET=
# Set only during a rotation: both values are accepted while the website flips over,
# then clear this one.
ATS_WEBHOOK_SECRET_PREVIOUS=

# --- Admin login (P5) ---
# PBKDF2 hash only, never the plaintext password. Generate with:
#   uv run python -m api.auth '<password>'
# Doubles as the session-cookie signing key, so changing it signs every staff session out
# — that is the intended revocation lever. Unset ⇒ /login returns 503 and every UI route
# is shut (default-deny).
ADMIN_PASSWORD_HASH=

# --- Cron drain (P11.1) ---
# Grading runs from POST /api/cron/drain, which requires `Authorization: Bearer <this>`.
# On Vercel, set it in the project's env and the platform sends it automatically on
# scheduled invocations. Unset ⇒ the endpoint fails closed, so NOTHING is ever graded:
# applications pile up in `received` and /health goes 503 after an hour.
# Not needed for local runs that use SRIP_LOCAL_WORKER=1 (in-process loop instead).
CRON_SECRET=
